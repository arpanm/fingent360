# Development only. These defaults are not production secrets.
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:5173
POSTGRES_PORT=55432
POSTGRES_USER=fingent360
POSTGRES_PASSWORD=fingent360_local_only
POSTGRES_DB=fingent360
MONGO_PORT=57017
MONGO_USER=fingent360
MONGO_PASSWORD=fingent360_local_only
DATABASE_URL=postgresql://fingent360:fingent360_local_only@127.0.0.1:55432/fingent360
# Optional explicit separation; defaults above remain compatible and are NOT least privilege.
# First migrate with the existing owner URL. Privately choose a new runtime role/password,
# preserve the existing owner URL below, then set DATABASE_URL to that distinct runtime user.
# Never commit either real credential or pass it on the command line.
# MIGRATION_DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@127.0.0.1:55432/fingent360
# User runs: pnpm db:roles (preview), then pnpm db:roles --apply, then restarts the API.
# Both URLs must use the same loopback host/port/database and explicit schema options.
MONGODB_URI=mongodb://fingent360:fingent360_local_only@127.0.0.1:57017/fingent360?authSource=admin

# Run pnpm research:setup to add a private RESEARCH_ADMIN_TOKEN to .env.
# Never put this token in VITE_* variables or commit it.

# Optional server-side assistance and reviewed media preparation. No provider is required.
# auto selects a configured key/model pair; query always uses local references.
# Provider failure also falls back to query-based suggestions.
AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
