# Development only. These defaults are not production secrets.
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:5173
POSTGRES_PORT=55432
POSTGRES_USER=fingent360
POSTGRES_PASSWORD=fingent360_local_only
POSTGRES_DB=fingent360
MONGO_PORT=57017
MONGO_USER=fingent360
MONGO_PASSWORD=fingent360_local_only
DATABASE_URL=postgresql://fingent360:fingent360_local_only@127.0.0.1:55432/fingent360
# Optional explicit separation; defaults above remain compatible and are NOT least privilege.
# First migrate with the existing owner URL. Privately choose a new runtime role/password,
# preserve the existing owner URL below, then set DATABASE_URL to that distinct runtime user.
# Never commit either real credential or pass it on the command line.
# MIGRATION_DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@127.0.0.1:55432/fingent360
# User runs: pnpm db:roles (preview), then pnpm db:roles --apply, then restarts the API.
# Both URLs must use the same loopback host/port/database and explicit schema options.
MONGODB_URI=mongodb://fingent360:fingent360_local_only@127.0.0.1:57017/fingent360?authSource=admin

# Run pnpm research:setup to add a private RESEARCH_ADMIN_TOKEN to .env.
# Never put this token in VITE_* variables or commit it.

# Optional server-side assistance and reviewed media preparation. No provider is required.
# auto selects a configured key/model pair; query always uses local references.
# Provider failure also falls back to query-based suggestions.
AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Explicit operator mode. Bootstrap keeps the existing local shared-key workflow.
OPS_AUTH_MODE=bootstrap
# Named administrator provisioning takes OPERATOR_USERNAME / OPERATOR_PASSWORD
# from temporary private environment values; never commit real credentials here.

# Automatic enabled-source refresh runs while API is running. Set false to pause worker globally.
RESEARCH_AUTO_ENABLED=true

# Optional paid image generation; use a supported image model and matching server key.
STORY_IMAGE_PROVIDER=off
# STORY_IMAGE_MODEL=

# Private server-data encryption: feedback, financial records, MFA and opted-in AI history.
# Configure before using these connected features. Server only; never use VITE_ names.
# Configure a JSON key ring of independently generated 32-byte base64 keys in ignored .env.
# Missing keys fail closed; public reading and device-only storage do not use these keys.
# Keep previous keys until ALL retained rows/history/backups using them are rewrapped/expired.
# PRIVATE_DATA_ACTIVE_KEY=local_v1
# PRIVATE_DATA_KEYS={"local_v1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}
# Stable username blind-index key, generated by pnpm privacy:keys. Preserve separately.
# Payload key rotation must NOT replace this lookup key; restore it if lost.
# PRIVATE_IDENTITY_LOOKUP_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY

# Optional read-only Kite integration. Credentials remain server-only.
# Enable only after provider app/callback registration and permission for stored end-user holdings.
KITE_ENABLED=false
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URL=https://your-api.example/api/v1/account/broker-connections/kite/callback
# KITE_PERMISSION_REFERENCE=

# Upstox connection: registered callback and documented retention permission required.
UPSTOX_ENABLED=false
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URL=https://your-api.example/api/v1/account/broker-connections/upstox/callback
# UPSTOX_PERMISSION_REFERENCE=

# Angel publisher app only; truthful deployment headers and explicit provider permission required.
ANGEL_ENABLED=false
# ANGEL_API_KEY=
# ANGEL_REDIRECT_URL=https://your-api.example/api/v1/account/broker-connections/angel/callback
# ANGEL_PERMISSION_REFERENCE=
# ANGEL_CLIENT_LOCAL_IP=
# ANGEL_CLIENT_PUBLIC_IP=
# ANGEL_MAC_ADDRESS=

# CCIL indicative yield context: enable only after actual source retention/display/offline permission.
CCIL_ZERO_ENABLED=false
# CCIL_ZERO_PERMISSION_REFERENCE=Actual written grant covering NSS parameters and storage/web/offline use
CCIL_ENABLED=false
# CCIL_PERMISSION_REFERENCE=Private internal reference to the applicable written grant

# WhatsApp is disabled until the actual business/template/source approvals are configured.
WHATSAPP_ENABLED=false
WHATSAPP_AUTOMATIC_DISPATCH=false
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_PUBLIC_ORIGIN=
# WHATSAPP_APPROVAL_REFERENCE=
# WHATSAPP_ALLOWED_SOURCE_IDS=

# Regulatory originals require actual source-specific retention/display permission.
REGULATORY_SOURCES_ENABLED=false
# REGULATORY_SOURCES_PERMISSION_REFERENCE=Internal reference to the actual applicable grant
