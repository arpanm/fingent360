{
  "name": "@fingent360/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently --kill-others \"tsc -p tsconfig.json --watch\" \"node --env-file=../../.env --watch dist/main.js\"",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fingent360/contracts": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2",
    "pg": "8.23.0",
    "mongodb": "7.6.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
