  "_completion": {
    "ACCOUNT-001": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Account registration, owner isolation, watchlists, bounded sign-in navigation, recovery from unavailable reads, deletion and shared on-device watchlist persistence. Native release certification is separate."
    },
    "GOALS-001": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Authenticated saved-goal creation, repeat goal types, exact contribution-only calculations, versioned edits/history, removal, draft protection and shared offline persistence. Financial advice and native release certification are separate."
    },
    "DEV-006": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Reviewed five/six-point brief preparation, independent issue, immutable correction/reissue/withdrawal, current source re-admission, failure/retry and source/detail navigation in web and the shared offline reader. Live source permission/editorial activation and native release certification remain operational release prerequisites."
    },
    "IMPACT-TRACE-001": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Source-bound qualitative evidence-to-holding/goal receipts, consent and recovery, version/conflict/withdrawal checks, independently released mechanisms, descriptive source diagnostics and shared offline persistence. No quantified causal forecast, trade or automatic financial change is claimed. Live source activation and native certification remain operational release prerequisites."
    },
    "ACTION-CENTRE-001": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Educational no-action, sell, purchase and FIFO rebalance comparisons with explicit suitability/cost constraints, supported tax policy or reviewed assumptions, immutable owned receipts and equivalent on-device behavior. Does not authorize personalized advice or trade execution."
    },
    "REPORTS-001": {
      "implementationComplete": true,
      "externalGates": [],
      "scope": "Owned saved-record snapshot capture, isolated queued preparation, immutable issuance/download, cancellation/recovery, schedule uniqueness/pause controls, populated records, report research/comparison navigation and shared offline report storage. Production hosting and native certification remain release prerequisites."
    }
  }
