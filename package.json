{
  "name": "fingent360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev-preflight.mjs && pnpm build && concurrently --kill-others -n contracts,api,web \"pnpm --filter @fingent360/contracts dev\" \"pnpm --filter @fingent360/api dev\" \"pnpm --filter @fingent360/web dev\"",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @fingent360/contracts build && pnpm -r typecheck",
    "test": "pnpm build && pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm e2e:typecheck && pnpm test",
    "db:up": "docker compose --env-file .env -f infra/local/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/local/compose.yaml down",
    "db:status": "docker compose --env-file .env -f infra/local/compose.yaml ps",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "node scripts/e2e.mjs ui",
    "e2e:run": "node scripts/e2e.mjs run",
    "e2e:report": "node scripts/e2e.mjs report",
    "e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "db:migrate": "pnpm --filter @fingent360/api db:migrate"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.9.1",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6",
    "concurrently": "10.0.5",
    "@types/node": "24.13.4",
    "globals": "17.4.0",
    "@playwright/test": "1.58.2"
  }
}
