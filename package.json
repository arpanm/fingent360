{
  "name": "fingent360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "android:setup": "node scripts/android-setup.mjs",
    "android:snapshot": "node scripts/offline-snapshot.mjs",
    "android:web": "node scripts/android-package.mjs --web-only",
    "android:build": "node scripts/android-package.mjs",
    "android:test": "node scripts/offline-tests.mjs",
    "android:test:ui": "node scripts/offline-tests.mjs --ui",
    "sdlc": "node scripts/sdlc.mjs",
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @fingent360/contracts build && pnpm -r typecheck",
    "test": "pnpm build && pnpm -r --if-present test && node --test tests/unit/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm e2e:typecheck && pnpm test",
    "db:up": "node scripts/local-db.mjs",
    "db:down": "docker compose --env-file .env -f infra/local/compose.yaml down",
    "db:status": "docker compose --env-file .env -f infra/local/compose.yaml ps",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "node scripts/e2e.mjs ui",
    "e2e:run": "node scripts/e2e.mjs run",
    "e2e:report": "node scripts/e2e.mjs report",
    "e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "db:migrate": "pnpm --filter @fingent360/api db:migrate",
    "research:setup": "node scripts/research-setup.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "research:refresh": "node scripts/research-refresh.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.9.1",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6",
    "concurrently": "10.0.5",
    "@types/node": "24.13.4",
    "globals": "17.4.0",
    "@playwright/test": "1.58.2"
  }
}
